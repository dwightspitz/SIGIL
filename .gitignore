# Ignore everything by default
*

# But track these specific items
!.gitignore
!README.md

# Track assets folder (logos, images)
!assets/
!assets/**

# Track PINESCRIPT folder and its contents
!PINESCRIPT/
!PINESCRIPT/**

# Track SCRY folder (for Streamlit deployment)
!SCRY/
!SCRY/streamlit_app.py
!SCRY/requirements.txt
!SCRY/requirements_streamlit.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
